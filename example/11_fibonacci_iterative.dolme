func fib(n: int): int {
    let a: int = 0;
    let b: int = 1;
    let i: int = 0;
    let next: int = 0;

    while (i < n) {
        next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }

    return a;
}

let f0: int = fib(0);
let f1: int = fib(1);
let f7: int = fib(7);
let f10: int = fib(10);

print(f0);
print(f1);
print(f7);
print(f10);
