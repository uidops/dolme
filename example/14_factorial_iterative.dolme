func factorial(n: int): int {
    let result: int = 1;

    while (n > 1) {
        result = result * n;
        n = n - 1;
    }

    return result;
}

let f0: int = factorial(0);
let f1: int = factorial(1);
let f5: int = factorial(5);
let f7: int = factorial(7);

print(f0);
print(f1);
print(f5);
print(f7);
