func collatz_steps(n: int): int {
    let steps: int = 0;

    while (n != 1) {
        if ((n % 2) == 0) {
            n = n / 2;
        } else {
            n = (3 * n) + 1;
        }

        steps = steps + 1;
    }

    return steps;
}

let a: int = collatz_steps(6);
let b: int = collatz_steps(27);

print(a);
print(b);
